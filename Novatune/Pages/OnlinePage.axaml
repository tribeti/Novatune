<UserControl
    x:Class="Novatune.Pages.OnlinePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Novatune.Pages"
    xmlns:models="using:Novatune.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <!--  Search Section  -->
        <StackPanel
            Grid.Row="0"
            Margin="20,30,0,20"
            Orientation="Horizontal"
            Spacing="10">
            <TextBox
                x:Name="SearchTextBox"
                Width="300"
                KeyDown="SearchTextBox_KeyDown"
                Watermark="Enter song or keywords"
                Text="{Binding ViewModel.SearchQuery, Mode=TwoWay}"/>

            <Button Command="{Binding ViewModel.SearchCommand}" Classes="Accent">
                <PathIcon Data="M20.94,20C20.94,20 15.73,16.74 15.73,16.74C17.26,15.23 18.25,13.13 18.25,10.75C18.25,6.33 14.67,2.75 10.25,2.75C5.83,2.75 2.25,6.33 2.25,10.75C2.25,15.17 5.83,18.75 10.25,18.75C12.63,18.75 14.73,17.76 16.24,16.23C16.24,16.23 19.5,21.44 19.5,21.44L20.94,20M10.25,17C6.77,17 3.95,14.18 3.95,10.7C3.95,7.22 6.77,4.4 10.25,4.4C13.73,4.4 16.55,7.22 16.55,10.7C16.55,14.18 13.73,17 10.25,17Z" />
            </Button>
        </StackPanel>

        <!--  Videos ListBox  -->
        <ListBox
            x:Name="VideosListBox"
            Grid.Row="1"
            Margin="20,20,20,0"
            ItemsSource="{Binding ViewModel.Videos}"
            SelectionMode="None">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:OnlineModel">
                    <Grid
                        Margin="0,5"
                        ColumnDefinitions="120,*,Auto"
                        Padding="10">
                        
                        <!--  Thumbnail  -->
                        <Border
                            Grid.Column="0"
                            Width="120"
                            Height="68"
                            CornerRadius="4"
                            ClipToBounds="True">
                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                        </Border>

                        <!--  Video Info  -->
                        <StackPanel
                            Grid.Column="1"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                MaxLines="2"
                                Text="{Binding Title}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="#80000000"
                                Text="{Binding Author}" />
                        </StackPanel>

                        <!--  Duration  -->
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#80000000"
                            Text="{Binding DurationDisplay}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Templates.ControlTemplate">
                        <ControlTemplate>
                            <ContentPresenter 
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}">
                                <Interaction.Behaviors>
                                    <EventTrigger EventName="Tapped">
                                        <InvokeCommandAction Command="{Binding $parent[ListBox].DataContext.ViewModel.PlayVideoCommand}" 
                                                           CommandParameter="{Binding}" />
                                    </EventTrigger>
                                </Interaction.Behaviors>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter>
                </Style>
            </ListBox.Styles>
        </ListBox>
    </Grid>
</UserControl>
