<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" x:Class="Novatune.Controls.MediaControlsView">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid Height="140" VerticalAlignment="Bottom" 
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,8,16,4" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Margin="0,0,8,0" 
                           VerticalAlignment="Center" FontSize="12" Text="00:00" />
                <Slider x:Name="TimeSlider" Grid.Column="1" VerticalAlignment="Center" 
                        IsThumbToolTipEnabled="False" StepFrequency="1" />
                <TextBlock x:Name="TotalTimeText" Grid.Column="2" Margin="8,0,0,0" 
                           VerticalAlignment="Center" FontSize="12" Text="00:00" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Vertical">
                    <TextBlock x:Name="MediaTitleText" Margin="0,0,0,4" FontSize="14" FontWeight="SemiBold" 
                               Text="Không có file nào đang phát" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="14" HorizontalAlignment="Right" 
                            VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">

                    <Button x:Name="ShuffleButton" Width="45" Height="45" Background="Transparent" 
                            BorderThickness="0" Click="ShuffleButton_Click" CornerRadius="200">
                        <Grid>
                            <FontIcon x:Name="ShuffleIcon" FontSize="16" 
                                      Glyph="{Binding ShuffleGlyph, Mode=OneWay}" />
                            <FontIcon x:Name="ShuffleOffOverlay" HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" FontSize="16" Glyph="&#xE894;" 
                                      IsVisible="False" />
                        </Grid>
                    </Button>
                    <Button x:Name="PreviousButton" Width="40" Height="40" Background="Transparent" 
                            BorderThickness="0" Click="PreviousButton_Click" CornerRadius="20" 
                            ToolTip.Tip="Previous">
                        <FontIcon FontSize="16" Glyph="&#xE892;" />
                    </Button>
                    <Button x:Name="SeekBackwardButton" Width="40" Height="40" Background="Transparent" 
                            BorderThickness="0" Click="SeekBackwardButton_Click" CornerRadius="20" 
                            ToolTip.Tip="Seek backward 5s">
                        <FontIcon FontSize="16" Glyph="&#xEB9E;" />
                    </Button>
                    <Button x:Name="PlayPauseButton" Width="60" Height="60" Background="Transparent" 
                            BorderThickness="0" Click="PlayPauseButton_Click" CornerRadius="200" 
                            ToolTip.Tip="Play/Pause">
                        <FontIcon x:Name="PlayPauseIcon" FontSize="20" Glyph="" />
                    </Button>
                    <Button x:Name="SeekForwardButton" Width="40" Height="40" Background="Transparent" 
                            BorderThickness="0" Click="SeekForwardButton_Click" CornerRadius="20" 
                            ToolTip.Tip="Seek forward 5s">
                        <FontIcon FontSize="16" Glyph="&#xEB9D;" />
                    </Button>
                    <Button x:Name="NextButton" Width="40" Height="40" Background="Transparent" 
                            BorderThickness="0" Click="NextButton_Click" CornerRadius="20" 
                            ToolTip.Tip="Next">
                        <FontIcon FontSize="16" Glyph="&#xE101;" />
                    </Button>
                    <Button x:Name="RepeatButton" Width="40" Height="40" Background="Transparent" 
                            BorderThickness="0" Click="RepeatButton_Click" CornerRadius="20">
                        <FontIcon x:Name="RepeatIcon" FontSize="16" 
                                  Glyph="{Binding RepeatGlyph, Mode=OneWay}" />
                    </Button>
                    <Button x:Name="StopButton" Width="40" Height="40" Background="Transparent" 
                            BorderThickness="0" Click="StopButton_Click" CornerRadius="20" 
                            ToolTip.Tip="Reset">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
