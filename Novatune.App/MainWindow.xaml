<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Novatune.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Novatune.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Novatune.App"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="20,20,20,10"
            Background="#15FFFFFF"
            BorderBrush="#20FFFFFF"
            BorderThickness="1"
            CornerRadius="8">

            <NavigationView
                x:Name="NavigationBar"
                AlwaysShowHeader="False"
                ExpandedModeThresholdWidth="500"
                IsBackButtonVisible="Collapsed"
                IsBackEnabled="False"
                IsSettingsVisible="True"
                IsTabStop="False"
                PaneDisplayMode="Top"
                SelectionChanged="NavigationBar_SelectionChanged"
                SelectionFollowsFocus="Enabled">

                <NavigationView.MenuItems>
                    <NavigationViewItem
                        x:Name="HomePage"
                        Content="Home"
                        Tag="Novatune.App.Views.HomePage">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Home" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="LibraryPage"
                        Content="Library"
                        Tag="Novatune.App.Views.LibraryPage">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Save" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="SamplePage3Item"
                        Content="Menu Item3"
                        Tag="SamplePage3">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Refresh" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <Frame x:Name="ContentFrame" NavigationFailed="ContentFrame_NavigationFailed" />
            </NavigationView>
        </Border>


        <Grid Grid.Row="1" Margin="20,10,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,15,0"
                Background="#10FFFFFF"
                BorderBrush="#20FFFFFF"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <MediaPlayerElement
                        HorizontalAlignment="Stretch"
                        AreTransportControlsEnabled="True"
                        AutoPlay="False"
                        Source="ms-appx:///Assets/big_buck_bunny_720_10s_2mb.mp4">
                        <MediaPlayerElement.TransportControls>
                            <MediaTransportControls
                                IsCompact="False"
                                IsNextTrackButtonVisible="True"
                                IsPreviousTrackButtonVisible="True"
                                IsRepeatButtonVisible="True"
                                IsRepeatEnabled="True"
                                IsSkipBackwardButtonVisible="True"
                                IsSkipForwardButtonVisible="True"
                                IsZoomButtonVisible="True" />
                        </MediaPlayerElement.TransportControls>
                    </MediaPlayerElement>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="15"
                Background="#10FFFFFF"
                BorderBrush="#20FFFFFF"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="60"
                            Height="60"
                            Background="Gray"
                            CornerRadius="4" />
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="I Ka Barra (Your Work)"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="LightGray"
                                Text="Habib Koité &amp; Bamada" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="Gray"
                                Text="Playlist" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <FontIcon
                                FontSize="14"
                                Foreground="LightGray"
                                Glyph="&#xE8B1;" />
                            <FontIcon
                                FontSize="14"
                                Foreground="LightGray"
                                Glyph="&#xE8EE;" />
                            <FontIcon
                                FontSize="14"
                                Foreground="LightGray"
                                Glyph="&#xE894;" />
                        </StackPanel>
                        <FontIcon
                            HorizontalAlignment="Right"
                            FontSize="14"
                            Foreground="LightGray"
                            Glyph="&#xE74D;" />
                    </Grid>

                    <ListView
                        Grid.Row="2"
                        Background="Transparent"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Left"
                                        Background="DarkGray"
                                        CornerRadius="2" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="LightGray"
                                        Text="Tên bài hát - Nghệ sĩ" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <ListViewItem>
                            <TextBlock Foreground="LightGray" Text="Amanda - Aisha Duo" />
                        </ListViewItem>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" />
    </Grid>
</Window>
