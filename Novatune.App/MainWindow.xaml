<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Novatune.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Novatune.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Novatune.App.Models"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="titleBar"
            Title="Novatune"
            Grid.Row="0">
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinWidth="400"
                    VerticalAlignment="Center"
                    GotFocus="SearchBox_GotFocus"
                    PlaceholderText="Search for online media"
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    TextChanged="SearchBox_TextChanged">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <Grid Margin="0,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    MaxWidth="300"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />

                                <Button
                                    Grid.Column="1"
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Add to queue"
                                    Click="AddtoQueue_Btn_Click"
                                    ClickMode="Press"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Add to queue">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="NavigationBar"
            Grid.Row="1"
            AlwaysShowHeader="False"
            ExpandedModeThresholdWidth="500"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="False"
            IsSettingsVisible="True"
            IsTabStop="False"
            Loaded="NavigationBar_Loaded"
            PaneDisplayMode="Top"
            SelectionChanged="NavigationBar_SelectionChanged"
            SelectionFollowsFocus="Enabled">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomePage"
                    Content="Home"
                    Tag="Novatune.App.Views.HomePage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="LibraryPage"
                    Content="Library"
                    Tag="Novatune.App.Views.LibraryPage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame
                x:Name="ContentFrame"
                Background="Transparent"
                NavigationFailed="ContentFrame_NavigationFailed" />
        </NavigationView>

        <Grid Grid.Row="2" Margin="12,12,36,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <controls:SwitchPresenter Grid.Column="0" Value="{x:Bind ViewModel.IsLive, Mode=OneWay}">
                <controls:Case>
                    <controls:Case.Value>
                        <x:Boolean>False</x:Boolean>
                    </controls:Case.Value>
                    <RelativePanel>
                        <TextBlock
                            x:Name="Position_Txt"
                            Margin="0,6,12,0"
                            VerticalAlignment="Center"
                            RelativePanel.AlignLeftWithPanel="True"
                            Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />

                        <TextBlock
                            x:Name="Duration_Txt"
                            Margin="12,6,0,0"
                            VerticalAlignment="Center"
                            RelativePanel.AlignRightWithPanel="True"
                            Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />

                        <Slider
                            x:Name="Media_Timeline"
                            VerticalAlignment="Center"
                            Loaded="Media_Timeline_Loaded"
                            Maximum="{x:Bind ViewModel.MediaDuration, Mode=OneWay}"
                            RelativePanel.LeftOf="Duration_Txt"
                            RelativePanel.RightOf="Position_Txt"
                            Tapped="Media_Timeline_Tapped"
                            ThumbToolTipValueConverter="{StaticResource TimelineFormatter}"
                            Value="{x:Bind ViewModel.TimelinePosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <AppBarButton
                            x:Name="Play_Btn"
                            Click="Play_Btn_Click"
                            LabelPosition="Collapsed"
                            RelativePanel.AlignHorizontalCenterWithPanel="True"
                            RelativePanel.Below="Media_Timeline"
                            ToolTipService.ToolTip="Play/Pause">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="{x:Bind ViewModel.PlayGlyph, Mode=OneWay}" />
                            </AppBarButton.Icon>

                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Space" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>

                        <AppBarButton
                            x:Name="Previous_Btn"
                            Click="Previous_Btn_Click"
                            LabelPosition="Collapsed"
                            RelativePanel.Below="Media_Timeline"
                            RelativePanel.LeftOf="Play_Btn"
                            ToolTipService.ToolTip="Previous">
                            <FontIcon Glyph="&#xF8AC;" />
                        </AppBarButton>

                        <AppBarButton
                            x:Name="Shuffle_Btn"
                            Click="Shuffle_Btn_Click"
                            LabelPosition="Collapsed"
                            RelativePanel.Below="Media_Timeline"
                            RelativePanel.LeftOf="Previous_Btn"
                            ToolTipService.ToolTip="Shuffle">
                            <FontIcon FontWeight="{x:Bind ViewModel.ShuffleFontWeight, Mode=OneWay}" Glyph="&#xE8B1;" />
                        </AppBarButton>

                        <AppBarButton
                            x:Name="Next_Btn"
                            Click="Next_Btn_Click"
                            LabelPosition="Collapsed"
                            RelativePanel.Below="Media_Timeline"
                            RelativePanel.RightOf="Play_Btn"
                            ToolTipService.ToolTip="Next">
                            <FontIcon Glyph="&#xF8AD;" />
                        </AppBarButton>

                        <AppBarButton
                            x:Name="Repeat_Btn"
                            Click="Repeat_Btn_Click"
                            LabelPosition="Collapsed"
                            RelativePanel.Below="Media_Timeline"
                            RelativePanel.RightOf="Next_Btn"
                            ToolTipService.ToolTip="Repeat">
                            <FontIcon FontWeight="{x:Bind ViewModel.RepeatFontWeight, Mode=OneWay}" Glyph="&#xE8EE;" />
                        </AppBarButton>
                    </RelativePanel>
                </controls:Case>
                <controls:Case>
                    <controls:Case.Value>
                        <x:Boolean>True</x:Boolean>
                    </controls:Case.Value>
                    <RelativePanel>
                        <AppBarButton
                            x:Name="Radio_Play_Btn"
                            Click="Play_Btn_Click"
                            LabelPosition="Collapsed"
                            RelativePanel.AlignHorizontalCenterWithPanel="True"
                            RelativePanel.AlignVerticalCenterWithPanel="True">
                            <FontIcon Glyph="{x:Bind ViewModel.PlayGlyph, Mode=OneWay}" />

                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Space" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>

                        <AppBarButton
                            x:Name="Radio_Previous_Btn"
                            Click="Previous_Btn_Click"
                            LabelPosition="Collapsed"
                            RelativePanel.AlignVerticalCenterWithPanel="True"
                            RelativePanel.LeftOf="Radio_Play_Btn"
                            ToolTipService.ToolTip="Previous">
                            <FontIcon Glyph="&#xF8AC;" />
                        </AppBarButton>

                        <AppBarButton
                            x:Name="Radio_Next_Btn"
                            Click="Next_Btn_Click"
                            LabelPosition="Collapsed"
                            RelativePanel.AlignVerticalCenterWithPanel="True"
                            RelativePanel.RightOf="Radio_Play_Btn"
                            ToolTipService.ToolTip="Next">
                            <FontIcon Glyph="&#xF8AD;" />
                        </AppBarButton>
                    </RelativePanel>
                </controls:Case>
            </controls:SwitchPresenter>

            <RelativePanel Grid.Column="1" Margin="36,0,0,0">
                <FontIcon
                    x:Name="Volume"
                    Margin="0,6,12,0"
                    Glyph="&#xE767;" />

                <Slider
                    x:Name="Volume_Slider"
                    RelativePanel.AlignRightWithPanel="True"
                    RelativePanel.RightOf="Volume"
                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />

                <Button
                    x:Name="Queue_Btn"
                    Click="Queue_Btn_Click"
                    RelativePanel.Below="Volume_Slider"
                    RelativePanel.LeftOf="MiniPlayer_Btn"
                    Style="{StaticResource IconOnlyButtonStyle}"
                    ToolTipService.ToolTip="Queue">
                    <FontIcon Glyph="&#xE93C;" />
                </Button>

                <AppBarButton
                    x:Name="MiniPlayer_Btn"
                    LabelPosition="Collapsed"
                    RelativePanel.Below="Volume_Slider"
                    RelativePanel.LeftOf="MediaSetting_Btn"
                    Style="{StaticResource IconOnlyButtonStyle}"
                    ToolTipService.ToolTip="Mini Player">
                    <FontIcon Glyph="&#xEE49;" />
                </AppBarButton>

                <Button
                    x:Name="MediaSetting_Btn"
                    RelativePanel.AlignRightWithPanel="True"
                    RelativePanel.Below="Volume_Slider"
                    Style="{StaticResource IconOnlyButtonStyle}">
                    <Button.Content>
                        <AnimatedIcon x:Name="SettingsAnimatedIcon">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Setting" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button.Content>
                    <Button.Flyout>
                        <Flyout>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ComboBox
                                    x:Name="Output_Box"
                                    Grid.Row="0"
                                    Header="Audio Output Selection"
                                    Loaded="Output_Box_Loaded"
                                    SelectionChanged="Output_Box_SelectionChanged" />

                                <Slider
                                    x:Name="PlaybackSpeedSlider"
                                    Grid.Row="1"
                                    Header="Playback Speed"
                                    Maximum="2.0"
                                    Minimum="0.25"
                                    StepFrequency="0.25"
                                    ValueChanged="PlaybackSpeedSlider_ValueChanged"
                                    Value="1.0" />
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </RelativePanel>
        </Grid>
    </Grid>
</Window>
