<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Fluent blue - the WinUI / Windows 11 default accent  -->
    <Color x:Key="AccentFluentBlue">#0078D4</Color>
    <Color x:Key="AccentFluentBlueLight1">#429CE3</Color>
    <Color x:Key="AccentFluentBlueLight2">#76B9ED</Color>
    <Color x:Key="AccentFluentBlueLight3">#A6D8F5</Color>
    <Color x:Key="AccentFluentBlueDark1">#005FB1</Color>
    <Color x:Key="AccentFluentBlueDark2">#00427D</Color>
    <Color x:Key="AccentFluentBlueDark3">#00215C</Color>

    <!--  Green  -->
    <Color x:Key="AccentGreen">#107C10</Color>
    <Color x:Key="AccentGreenLight1">#409640</Color>
    <Color x:Key="AccentGreenLight2">#70B070</Color>
    <Color x:Key="AccentGreenLight3">#9FCB9F</Color>
    <Color x:Key="AccentGreenDark1">#0D630D</Color>
    <Color x:Key="AccentGreenDark2">#0A4A0A</Color>
    <Color x:Key="AccentGreenDark3">#063206</Color>

    <!--  Orange  -->
    <Color x:Key="AccentOrange">#C6500A</Color>
    <Color x:Key="AccentOrangeLight1">#D1733B</Color>
    <Color x:Key="AccentOrangeLight2">#DD966C</Color>
    <Color x:Key="AccentOrangeLight3">#E8B99D</Color>
    <Color x:Key="AccentOrangeDark1">#9E4008</Color>
    <Color x:Key="AccentOrangeDark2">#773006</Color>
    <Color x:Key="AccentOrangeDark3">#4F2004</Color>

    <!--  Purple  -->
    <Color x:Key="AccentPurple">#8458EA</Color>
    <Color x:Key="AccentPurpleLight1">#9D79EE</Color>
    <Color x:Key="AccentPurpleLight2">#B59BF2</Color>
    <Color x:Key="AccentPurpleLight3">#CEBCF7</Color>
    <Color x:Key="AccentPurpleDark1">#6A46BB</Color>
    <Color x:Key="AccentPurpleDark2">#4F358C</Color>
    <Color x:Key="AccentPurpleDark3">#35235E</Color>

    <!--  Rose  -->
    <Color x:Key="AccentRose">#CB3E84</Color>
    <Color x:Key="AccentRoseLight1">#D5659D</Color>
    <Color x:Key="AccentRoseLight2">#E08BB5</Color>
    <Color x:Key="AccentRoseLight3">#EAB2CE</Color>
    <Color x:Key="AccentRoseDark1">#A2326A</Color>
    <Color x:Key="AccentRoseDark2">#7A254F</Color>
    <Color x:Key="AccentRoseDark3">#511935</Color>

    <!--  swatch brushes for the SettingPage selector  -->
    <SolidColorBrush x:Key="AccentFluentBlueBrush" Color="{StaticResource AccentFluentBlue}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}" />
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrange}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}" />
    <SolidColorBrush x:Key="AccentRoseBrush" Color="{StaticResource AccentRose}" />
</ResourceDictionary>
