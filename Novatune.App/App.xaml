<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Novatune.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Novatune.App.Converters"
    xmlns:local="using:Novatune.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="/Styles/IconButtonStyle.xaml" />
                <!--  Other merged dictionaries here  -->
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#32CD32</Color>
                    <Color x:Key="SystemAccentColorLight1">#5CD65C</Color>
                    <Color x:Key="SystemAccentColorLight2">#85E085</Color>
                    <Color x:Key="SystemAccentColorLight3">#ADEBAD</Color>
                    <Color x:Key="SystemAccentColorDark1">#28A428</Color>
                    <Color x:Key="SystemAccentColorDark2">#1E7B1E</Color>
                    <Color x:Key="SystemAccentColorDark3">#145214</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="SystemAccentColor">#32CD32</Color>
                    <Color x:Key="SystemAccentColorLight1">#5CD65C</Color>
                    <Color x:Key="SystemAccentColorLight2">#85E085</Color>
                    <Color x:Key="SystemAccentColorLight3">#ADEBAD</Color>
                    <Color x:Key="SystemAccentColorDark1">#28A428</Color>
                    <Color x:Key="SystemAccentColorDark2">#1E7B1E</Color>
                    <Color x:Key="SystemAccentColorDark3">#145214</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <converters:TimelineConverter x:Key="TimelineFormatter" />

            <!--  Other app resources here  -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
