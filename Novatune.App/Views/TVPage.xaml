<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Novatune.App.Views.TVPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Novatune.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Novatune.App.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <SplitView
        x:Name="QueueSplitView"
        DisplayMode="Inline"
        IsPaneOpen="{x:Bind ViewModel.IsQueueVisible, Mode=OneWay}"
        OpenPaneLength="320"
        PaneBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
        PanePlacement="Right">
        <SplitView.Content>
            <MediaPlayerElement
                x:Name="mediaPlayerElement"
                AreTransportControlsEnabled="False"
                AutomationProperties.AutomationId="TVPlayer"
                Stretch="Uniform" />
        </SplitView.Content>
        <SplitView.Pane>
            <RelativePanel HorizontalAlignment="Stretch">
                <Button
                    x:Name="ClearList"
                    x:Uid="ClearListButton"
                    Margin="8"
                    AutomationProperties.AutomationId="ClearList"
                    AutomationProperties.Name="Clear Playlist"
                    Click="ClearList_Click"
                    RelativePanel.AlignRightWithPanel="True"
                    RelativePanel.AlignTopWithPanel="True"
                    Style="{StaticResource IconOnlyButtonStyle}"
                    ToolTipService.ToolTip="Clear Playlist">
                    <FontIcon Glyph="&#xE894;" />
                </Button>

                <local:QueueList
                    RelativePanel.AlignLeftWithPanel="True"
                    RelativePanel.AlignRightWithPanel="True"
                    RelativePanel.Below="ClearList"
                    ItemsSource="{x:Bind ViewModel.TvQueue, Mode=OneWay}"
                    SelectedTrack="{x:Bind ViewModel.CurrentTrack, Mode=OneWay}" />
            </RelativePanel>
        </SplitView.Pane>
    </SplitView>
</Page>
