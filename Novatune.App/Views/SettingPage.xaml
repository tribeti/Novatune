<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Novatune.App.Views.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Novatune.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <RelativePanel Margin="48,36,48,0" Background="Transparent">

        <!--  background setting  -->
        <TextBlock
            x:Name="Header"
            x:Uid="CloseBehaviorHeader"
            Style="{StaticResource BodyLargeStrongTextBlockStyle}"
            Text="Close behavior" />
        <TextBlock
            x:Name="Description"
            x:Uid="CloseBehaviorDescription"
            RelativePanel.Below="Header"
            Text="Close button should minimize app" />
        <ToggleSwitch
            x:Name="TraySwitch"
            x:Uid="TraySwitch"
            AutomationProperties.AutomationId="TraySwitch"
            RelativePanel.AlignRightWithPanel="True"
            RelativePanel.AlignVerticalCenterWith="Description"
            Toggled="TraySwitch_Toggled" />

        <!--  discord setting  -->
        <TextBlock
            x:Name="Header1"
            x:Uid="DiscordHeader"
            RelativePanel.Below="TraySwitch"
            Style="{StaticResource BodyLargeStrongTextBlockStyle}"
            Text="Discord RPC" />
        <TextBlock
            x:Name="Description1"
            x:Uid="DiscordDescription"
            RelativePanel.Below="Header1"
            Text="Show current track title, status, and elapsed playback time on your Discord profile" />
        <ToggleSwitch
            x:Name="RPCSwitch"
            x:Uid="RpcSwitch"
            AutomationProperties.AutomationId="RPCSwitch"
            RelativePanel.AlignRightWithPanel="True"
            RelativePanel.AlignVerticalCenterWith="Description1"
            Toggled="RPCSwitch_Toggled" />

        <!--  theme setting  -->
        <TextBlock
            x:Name="Header2"
            x:Uid="ThemeHeader"
            RelativePanel.Below="RPCSwitch"
            Style="{StaticResource BodyLargeStrongTextBlockStyle}"
            Text="Theme" />
        <TextBlock
            x:Name="Description2"
            x:Uid="ThemeDescription"
            RelativePanel.Below="Header2"
            Text="Choose light or dark mode, or follow the Windows setting" />
        <ComboBox
            x:Name="ThemeSelector"
            x:Uid="ThemeSelector"
            AutomationProperties.AutomationId="ThemeSelector"
            RelativePanel.AlignRightWithPanel="True"
            RelativePanel.AlignVerticalCenterWith="Description2"
            SelectionChanged="ThemeSelector_SelectionChanged">
            <ComboBoxItem x:Uid="ThemeDefaultItem" Content="Use Windows setting" />
            <ComboBoxItem x:Uid="ThemeLightItem" Content="Light" />
            <ComboBoxItem x:Uid="ThemeDarkItem" Content="Dark" />
        </ComboBox>

        <!--  accent color setting  -->
        <TextBlock
            x:Name="Header4"
            x:Uid="AccentHeader"
            Margin="0,8,0,0"
            RelativePanel.Below="Description2"
            Style="{StaticResource BodyLargeStrongTextBlockStyle}"
            Text="Accent color" />
        <TextBlock
            x:Name="Description4"
            x:Uid="AccentDescription"
            RelativePanel.Below="Header4"
            Text="Choose an accent color for the app, or follow the Windows setting" />
        <ComboBox
            x:Name="AccentSelector"
            x:Uid="AccentSelector"
            AutomationProperties.AutomationId="AccentSelector"
            RelativePanel.AlignRightWithPanel="True"
            RelativePanel.AlignVerticalCenterWith="Description4"
            SelectionChanged="AccentSelector_SelectionChanged">
            <ComboBoxItem x:Uid="AccentNoneItem">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Stroke="{ThemeResource ControlStrokeColorSecondaryBrush}"
                        StrokeThickness="1" />
                    <TextBlock
                        x:Uid="AccentNoneItemText"
                        VerticalAlignment="Center"
                        Text="None" />
                </StackPanel>
            </ComboBoxItem>
            <ComboBoxItem x:Uid="AccentBlueItem">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Fill="{StaticResource AccentFluentBlueBrush}" />
                    <TextBlock
                        x:Uid="AccentBlueItemText"
                        VerticalAlignment="Center"
                        Text="Fluent blue" />
                </StackPanel>
            </ComboBoxItem>
            <ComboBoxItem x:Uid="AccentGreenItem">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Fill="{StaticResource AccentGreenBrush}" />
                    <TextBlock
                        x:Uid="AccentGreenItemText"
                        VerticalAlignment="Center"
                        Text="Green" />
                </StackPanel>
            </ComboBoxItem>
            <ComboBoxItem x:Uid="AccentOrangeItem">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Fill="{StaticResource AccentOrangeBrush}" />
                    <TextBlock
                        x:Uid="AccentOrangeItemText"
                        VerticalAlignment="Center"
                        Text="Orange" />
                </StackPanel>
            </ComboBoxItem>
            <ComboBoxItem x:Uid="AccentPurpleItem">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Fill="{StaticResource AccentPurpleBrush}" />
                    <TextBlock
                        x:Uid="AccentPurpleItemText"
                        VerticalAlignment="Center"
                        Text="Purple" />
                </StackPanel>
            </ComboBoxItem>
            <ComboBoxItem x:Uid="AccentRoseItem">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Fill="{StaticResource AccentRoseBrush}" />
                    <TextBlock
                        x:Uid="AccentRoseItemText"
                        VerticalAlignment="Center"
                        Text="Rose" />
                </StackPanel>
            </ComboBoxItem>
        </ComboBox>

        <!--  language setting  -->
        <TextBlock
            x:Name="Header3"
            x:Uid="LanguageHeader"
            Margin="0,8,0,0"
            RelativePanel.Below="Description4"
            Style="{StaticResource BodyLargeStrongTextBlockStyle}"
            Text="Language" />
        <TextBlock
            x:Name="Description3"
            x:Uid="LanguageDescription"
            RelativePanel.Below="Header3"
            Text="Choose the app display language." />
        <ComboBox
            x:Name="LanguageSelector"
            x:Uid="LanguageSelector"
            AutomationProperties.AutomationId="LanguageSelector"
            RelativePanel.AlignRightWithPanel="True"
            RelativePanel.AlignVerticalCenterWith="Description3"
            SelectionChanged="LanguageSelector_SelectionChanged">
            <ComboBoxItem x:Uid="LanguageEnglishItem" Content="English" />
            <ComboBoxItem x:Uid="LanguageVietnameseItem" Content="Tiếng Việt" />
        </ComboBox>
    </RelativePanel>
</Page>
