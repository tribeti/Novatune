<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Novatune.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:Novatune.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Novatune.App.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*" />
            <ColumnDefinition Width="{x:Bind ViewModel.QueueColumnWidth, Mode=OneWay}" />
        </Grid.ColumnDefinitions>

        <MediaPlayerElement
            x:Name="mediaPlayerElement"
            Grid.Column="0"
            AreTransportControlsEnabled="False"
            PosterSource="/Assets/LockScreenLogo.png"
            Stretch="Uniform" />

        <dev:LoadingIndicator
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsMediaLoading, Mode=OneWay}"
            Mode="Wave" />

        <RelativePanel
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            Visibility="{x:Bind ViewModel.QueueVisibility, Mode=OneWay}">
            <AppBarButton
                x:Name="AddMedia"
                AutomationProperties.Name="Add local media"
                Command="{x:Bind ViewModel.AddLocalMediaCommand}"
                Icon="Folder"
                IsCompact="True"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.AlignTopWithPanel="True"
                ToolTipService.ToolTip="Add local media" />
            <Image
                x:Name="MediaLogo"
                MaxHeight="100"
                RelativePanel.AlignHorizontalCenterWithPanel="True"
                RelativePanel.Below="AddMedia"
                Source="{x:Bind ViewModel.CurrentImage, Mode=OneWay}" />
            <TextBlock
                x:Name="MediaTitle"
                FontSize="18"
                RelativePanel.AlignHorizontalCenterWithPanel="True"
                RelativePanel.Below="MediaLogo"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
            <MenuFlyoutSeparator
                x:Name="sep"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.Below="MediaTitle" />
            <ListView
                x:Name="Queue"
                HorizontalAlignment="Stretch"
                AllowDrop="True"
                Background="Transparent"
                ItemsSource="{x:Bind ViewModel.Playlist, Mode=OneWay}"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.Below="sep"
                SelectedItem="{x:Bind ViewModel.CurrentTrack, Mode=OneWay}"
                SelectionChanged="Queue_SelectionChanged"
                SelectionMode="Single">

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaItem">
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Subtitle}"
                                TextTrimming="CharacterEllipsis" />

                            <Button
                                x:Name="RemoveItem"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="RemoveItem_Click"
                                Content="&#xE711;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </RelativePanel>
    </Grid>
</Page>
