<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Novatune.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Novatune.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:storage="using:Windows.Storage"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <MediaPlayerElement
            x:Name="mediaPlayerElement"
            Grid.Column="0"
            AreTransportControlsEnabled="False"
            Stretch="Uniform" />

        <RelativePanel Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <AppBarButton
                x:Name="AddMedia"
                Command="{x:Bind ViewModel.AddMediaCommand}"
                Icon="Add"
                IsCompact="True"
                RelativePanel.AlignHorizontalCenterWithPanel="True" />
            <Image
                x:Name="MediaLogo"
                MaxHeight="100"
                RelativePanel.AlignHorizontalCenterWithPanel="True"
                RelativePanel.Below="AddMedia"
                Source="/Assets/LockScreenLogo.png" />
            <TextBlock
                x:Name="MediaTitle"
                FontSize="18"
                RelativePanel.AlignHorizontalCenterWithPanel="True"
                RelativePanel.Below="MediaLogo"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <MenuFlyoutSeparator x:Name="sep" RelativePanel.Below="MediaTitle" />
            <ListView
                AllowDrop="True"
                Background="Transparent"
                CanDragItems="True"
                CanReorderItems="True"
                ItemsSource="{x:Bind ViewModel.MediaFiles, Mode=OneWay}"
                RelativePanel.Below="sep"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="storage:StorageFile">
                        <StackPanel Margin="0,8" Orientation="Vertical">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Path}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </RelativePanel>
    </Grid>
</Page>
