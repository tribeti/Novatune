<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Novatune.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Novatune.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Novatune.App.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <SplitView
        x:Name="QueueSplitView"
        DisplayMode="Inline"
        IsPaneOpen="{x:Bind ViewModel.IsQueueVisible, Mode=OneWay}"
        OpenPaneLength="320"
        PaneBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
        PanePlacement="Right">
        <SplitView.Pane>
            <RelativePanel HorizontalAlignment="Stretch">
                <Button
                    x:Name="AddMedia"
                    x:Uid="AddMediaButton"
                    Margin="8"
                    AutomationProperties.AutomationId="AddMedia"
                    AutomationProperties.Name="Add local media"
                    Command="{x:Bind ViewModel.AddLocalMediaCommand}"
                    RelativePanel.AlignLeftWithPanel="True"
                    RelativePanel.AlignTopWithPanel="True"
                    Style="{StaticResource IconOnlyButtonStyle}"
                    ToolTipService.ToolTip="Add local media">
                    <FontIcon Glyph="&#xE8B7;" />
                </Button>

                <Button
                    x:Name="ClearList"
                    x:Uid="ClearListButton"
                    Margin="8"
                    AutomationProperties.AutomationId="ClearList"
                    AutomationProperties.Name="Clear Playlist"
                    Click="ClearList_Click"
                    RelativePanel.AlignRightWithPanel="True"
                    RelativePanel.AlignTopWithPanel="True"
                    Style="{StaticResource IconOnlyButtonStyle}"
                    ToolTipService.ToolTip="Clear Playlist">
                    <FontIcon Glyph="&#xE894;" />
                </Button>

                <Image
                    x:Name="MediaLogo"
                    MaxHeight="120"
                    RelativePanel.AlignHorizontalCenterWithPanel="True"
                    RelativePanel.Below="AddMedia"
                    Source="{x:Bind ViewModel.CurrentImage, Mode=OneWay}" />
                <TextBlock
                    x:Name="MediaTitle"
                    Padding="8"
                    FontSize="18"
                    RelativePanel.AlignHorizontalCenterWithPanel="True"
                    RelativePanel.Below="MediaLogo"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
                <MenuFlyoutSeparator
                    x:Name="sep"
                    RelativePanel.AlignLeftWithPanel="True"
                    RelativePanel.AlignRightWithPanel="True"
                    RelativePanel.Below="MediaTitle" />
                <local:QueueList
                    RelativePanel.AlignLeftWithPanel="True"
                    RelativePanel.AlignRightWithPanel="True"
                    RelativePanel.Below="sep"
                    ItemsSource="{x:Bind ViewModel.HomeQueue, Mode=OneWay}"
                    SelectedTrack="{x:Bind ViewModel.CurrentTrack, Mode=OneWay}" />
            </RelativePanel>
        </SplitView.Pane>
    </SplitView>
</Page>
