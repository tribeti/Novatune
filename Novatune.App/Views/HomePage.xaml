<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Novatune.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Novatune.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Novatune.App.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <MediaPlayerElement
            x:Name="mediaPlayerElement"
            Grid.Column="0"
            AreTransportControlsEnabled="False"
            Stretch="Uniform" />

        <RelativePanel
            Grid.Column="1"
            MaxWidth="500"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            Visibility="{x:Bind ViewModel.QueueVisibility, Mode=OneWay}">
            <AppBarButton
                x:Name="AddMedia"
                Command="{x:Bind ViewModel.AddLocalMediaCommand}"
                Icon="Add"
                IsCompact="True"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.AlignTopWithPanel="True" />
            <Image
                x:Name="MediaLogo"
                MaxHeight="100"
                RelativePanel.AlignHorizontalCenterWithPanel="True"
                RelativePanel.Below="AddMedia"
                Source="{x:Bind ViewModel.CurrentImage, Mode=OneWay}" />
            <TextBlock
                x:Name="MediaTitle"
                FontSize="18"
                RelativePanel.AlignHorizontalCenterWithPanel="True"
                RelativePanel.Below="MediaLogo"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <MenuFlyoutSeparator
                x:Name="sep"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.Below="MediaTitle" />
            <Expander
                x:Name="LocalExpander"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                ExpandDirection="Down"
                Header="Local Playlist"
                IsExpanded="False"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.Below="sep">
                <Expander.Content>
                <ListView
                        x:Name="Queue"
                        AllowDrop="True"
                        Background="Transparent"
                        ItemsSource="{x:Bind ViewModel.Playlist, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.LocalPlaylistIndex, Mode=OneWay}"
                        SelectionChanged="LocalList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaItem">
                                <StackPanel Margin="0,8" Orientation="Vertical">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Artist}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander.Content>
            </Expander>
            <Expander
                x:Name="RadioExpander"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                ExpandDirection="Down"
                Header="Radio Playlist"
                IsExpanded="False"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.Below="LocalExpander">
                <Expander.Content>
                    <ListView
                        x:Name="RadioList"
                        AllowDrop="True"
                        Background="Transparent"
                        ItemsSource="{x:Bind ViewModel.RadioPlaylist, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.RadioPlaylistIndex, Mode=OneWay}"
                        SelectionChanged="RadioList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RadioItem">
                                <StackPanel Margin="0,8" Orientation="Vertical">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Tags}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander.Content>
            </Expander>
        </RelativePanel>
    </Grid>
</Page>
