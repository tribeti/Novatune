<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Novatune.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Novatune.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Novatune.App.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        IsTabStop="True"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">

        <RelativePanel Padding="36">
            <TextBlock
                x:Name="Title3"
                x:Uid="LibraryTitle"
                Padding="0,16,0,16"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Online Playlist" />
            <Button
                x:Uid="AddPlaylistButton"
                Click="AddPlaylist_Click"
                Content="Add playlist"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.AlignVerticalCenterWith="Title3" />
            <ScrollViewer
                x:Name="OnlineList"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                IsVerticalScrollChainingEnabled="True"
                RelativePanel.Below="Title3"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled">
                <ItemsRepeater ItemsSource="{x:Bind OnlinePlaylistItems}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:YoutubePlaylist">
                            <Button
                                Padding="8"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                Click="PlaylistItem_Click"
                                DataContext="{x:Bind}"
                                ToolTipService.ToolTip="{x:Bind Title}">
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            x:Uid="PlayAllItem"
                                            Click="PlayPlaylist_Click"
                                            Tag="{x:Bind}"
                                            Text="Play All">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF5B0;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Uid="RefreshItem"
                                            Click="RefreshPlaylist_Click"
                                            Tag="{x:Bind}"
                                            Text="Refresh">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Uid="RemovePlaylistItem"
                                            Click="RemovePlaylist_Click"
                                            Tag="{x:Bind}"
                                            Text="Remove">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE711;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                                <StackPanel Width="180">
                                    <Border
                                        Height="120"
                                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                        CornerRadius="8">
                                        <Grid>
                                            <FontIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8D6;" />
                                            <Image
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{x:Bind local:LibraryPage.EntryThumbnail(ThumbnailUrl)}"
                                                Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Author}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <TextBlock
                x:Name="FavoritesTitle"
                x:Uid="FavoritesTitle"
                Padding="0,32,0,16"
                RelativePanel.Below="OnlineList"
                Style="{StaticResource TitleTextBlockStyle}" />
            <ScrollViewer
                x:Name="FavoritesList"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                IsVerticalScrollChainingEnabled="True"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.Below="FavoritesTitle"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled">
                <Grid>
                    <TextBlock
                        x:Uid="FavoritesEmpty"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Visibility="{x:Bind local:LibraryPage.InvertedBoolToVisibility(Vm.HasFavorites), Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Favorites}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:LibraryEntry">
                                <Button
                                    Padding="8"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    Click="LibraryEntry_Click"
                                    DataContext="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind Title}">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                x:Uid="PlayEntryItem"
                                                Click="PlayEntry_Click"
                                                Tag="{x:Bind}"
                                                Text="Play">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xF5B0;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                x:Uid="RemoveFavoriteItem"
                                                Click="RemoveFavorite_Click"
                                                Tag="{x:Bind}"
                                                Text="Remove from favourites">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE711;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <StackPanel Width="180">
                                        <Border
                                            Height="120"
                                            Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                            CornerRadius="8">
                                            <Grid>
                                                <FontIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8D6;" />
                                                <Image
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{x:Bind local:LibraryPage.EntryThumbnail(ThumbnailUrl)}"
                                                    Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </ScrollViewer>

            <TextBlock
                x:Name="RecentTitle"
                x:Uid="RecentTitle"
                Padding="0,32,0,16"
                RelativePanel.Below="FavoritesList"
                Style="{StaticResource TitleTextBlockStyle}" />
            <ScrollViewer
                x:Name="RecentList"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                IsVerticalScrollChainingEnabled="True"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.Below="RecentTitle"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled">
                <Grid>
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Recent}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:LibraryEntry">
                                <Button
                                    Padding="8"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    Click="LibraryEntry_Click"
                                    DataContext="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind Title}">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                x:Uid="PlayEntryItem"
                                                Click="PlayEntry_Click"
                                                Tag="{x:Bind}"
                                                Text="Play">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xF5B0;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                x:Uid="AddFavoriteItem"
                                                Click="AddFavorite_Click"
                                                Tag="{x:Bind}"
                                                Text="Add to favourites">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xEB52;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <StackPanel Width="180">
                                        <Border
                                            Height="120"
                                            Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                            CornerRadius="8">
                                            <Grid>
                                                <FontIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8D6;" />
                                                <Image
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{x:Bind local:LibraryPage.EntryThumbnail(ThumbnailUrl)}"
                                                    Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </ScrollViewer>
        </RelativePanel>
    </ScrollViewer>
</Page>
