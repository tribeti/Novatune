<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Novatune.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Novatune.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Novatune.App.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        IsTabStop="True"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">

        <RelativePanel Padding="36">
            <TextBlock
                x:Name="Title2"
                Padding="0,16,0,16"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="TV Channels" />
            <ScrollViewer
                x:Name="TVList"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                IsVerticalScrollChainingEnabled="True"
                RelativePanel.Below="Title2"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled">
                <ItemsRepeater ItemsSource="{x:Bind TvChannelsItems}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:IptvChannel">
                            <Button
                                x:Name="TVItem"
                                Padding="8"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                Click="TVItem_Click"
                                DataContext="{x:Bind}"
                                ToolTipService.ToolTip="{x:Bind Name}">
                                <StackPanel>
                                    <Image
                                        Width="150"
                                        Height="150"
                                        HorizontalAlignment="Left"
                                        Source="{x:Bind Logo}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <TextBlock
                x:Name="Title3"
                Padding="0,16,0,16"
                RelativePanel.Below="TVList"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Online Playlist" />
            <Button
                Click="AddPlaylist_Click"
                Content="Add playlist"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.AlignVerticalCenterWith="Title3" />
            <ScrollViewer
                x:Name="OnlineList"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                IsVerticalScrollChainingEnabled="True"
                RelativePanel.Below="Title3"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled">
                <ItemsRepeater ItemsSource="{x:Bind OnlinePlaylistItems}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:YoutubePlaylist">
                            <Button
                                Padding="8"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                Click="PlaylistItem_Click"
                                DataContext="{x:Bind}"
                                ToolTipService.ToolTip="{x:Bind Title}">
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Click="PlayPlaylist_Click"
                                            Tag="{x:Bind}"
                                            Text="Play All">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF5B0;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Click="RemovePlaylist_Click"
                                            Tag="{x:Bind}"
                                            Text="Remove">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE711;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                                <StackPanel Width="180">
                                    <Border
                                        Height="120"
                                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                        CornerRadius="8">
                                        <Image
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{x:Bind ThumbnailUrl}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Author}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </RelativePanel>
    </ScrollViewer>
</Page>